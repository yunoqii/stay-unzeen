// Reference for web/components/layout/logo.tsx (frontend owns the real file). Brand v4, 13.10.2026.
// Mark = folded two-layer tape (simple level for the header). Wordmark = D2a "un▬een".
// The header logo peels its tape on hover/focus: see docs/design/tape-peel.md and for-web/tape-peel.html.
import { cn } from "@/lib/utils";

/** Two-layer tape mark. Static SVG (several shapes and tones), so it ships as a file, not an inline path. */
export function TapeMark({ className }: { className?: string }) {
  // eslint-disable-next-line @next/next/no-img-element
  return <img src="/brand/logo-mark.svg" alt="" aria-hidden className={cn("size-6", className)} />;
}

/** Header logo: mark + small wordmark. The name stays readable for machines and screen readers. */
export function Wordmark({ className }: { className?: string }) {
  return (
    <span className={cn("inline-flex items-center gap-2", className)} role="img" aria-label="unzeen">
      <TapeMark />
      {/* 20-24px tall in the header; never below 16px. Use the -small (simple tape) file at this size. */}
      {/* eslint-disable-next-line @next/next/no-img-element */}
      <img src="/brand/unzeen-wordmark-small-on-dark.svg" alt="" aria-hidden className="h-6 w-auto" />
    </span>
  );
}
