# /etc/unzeen/monitor.env — SECRET (bot token): 0600 root:root. Read by unzeen-monitor (root, systemd timer).
# Telegram: create a bot with @BotFather, send it one message, take chat id from
# https://api.telegram.org/bot<token>/getUpdates (in a browser, not in a shared terminal).
TG_BOT_TOKEN=
TG_CHAT_ID=
# Optional local command instead of / in addition to Telegram; gets the message on stdin.
ALERT_CMD=
# Re-send an unresolved alert every N seconds (default 6 h).
ALERT_REPEAT_SECS=21600
# Thresholds (seconds).
PRICE_MAX_AGE_SECS=900
INVENTORY_MAX_AGE_SECS=1800
SCAN_PASS_MAX_AGE_SECS=900
