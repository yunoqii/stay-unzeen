# /etc/unzeen/stack.env — NOT secret (hosts, public build flags). 0644 root:root.
# Read by `docker compose --env-file` (interpolation) and sourced by unzeenctl / unzeen-monitor.
# Keep KEY=value without spaces or quotes.

# Instances started by unzeenctl (comma separated). Leave one out until its keys exist.
UNZEEN_INSTANCES=devnet,mainnet,hood
UNZEEN_ETC=/etc/unzeen
UNZEEN_VAULT=/srv/unzeen

# Hosts (bare names, no scheme). Own domain (A/AAAA records to the VPS, no CDN proxy):
WEB_HOST=unzeen.example
API_DEVNET_HOST=api-devnet.unzeen.example
API_MAINNET_HOST=api-mainnet.unzeen.example
API_HOOD_HOST=api-hood.unzeen.example
# Without a domain: <ip with dashes>.sslip.io, e.g. WEB_HOST=203-0-113-7.sslip.io and
# API_DEVNET_HOST=api-devnet.203-0-113-7.sslip.io (RUNBOOK "Деплой на VPS" §D.4 — not for mainnet launches).

# Web build (inlined at build time; rebuild after a change). Pubkeys = `keys:attest` verify key,
# hood `evm:keys` attest address. Empty = "not pinned" on /verify.
NEXT_PUBLIC_ATTESTATION_PUBKEY_DEVNET=
NEXT_PUBLIC_ATTESTATION_PUBKEY_MAINNET=
NEXT_PUBLIC_ATTESTATION_PUBKEY_HOOD=
NEXT_PUBLIC_HOOD=1
# Until 28.10 23:59 UTC: empty + build:public (strict check: no fair-launch code in the bundle).
# After the deadline: NEXT_PUBLIC_FAIR_LAUNCH_BUILD=1 and WEB_BUILD_SCRIPT=build.
NEXT_PUBLIC_FAIR_LAUNCH_BUILD=
WEB_BUILD_SCRIPT=build:public

# Proxy limits per client address (in memory only), events per window (API 10 s, WS 1 min, web 10 s).
RL_API_READ_EVENTS=300
RL_API_WRITE_EVENTS=30
RL_WS_EVENTS=30
RL_WEB_EVENTS=600
