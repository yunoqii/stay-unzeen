# /etc/unzeen/hood.env — instance "hood" (Zcash main + Robinhood Chain mainnet 4663). SECRET: 0640 root:<admin>.
# Own Zcash seed/UA (wallet in $UNZEEN_HOME/hood-main, GAP-9), own DB. RUNBOOK §5, mainnet-demo-run §1.3.
# Set by compose: UNZEEN_HOME, API_BIND, API_CORS_ORIGINS, UNZEEN_METADATA_BASE_URL, *_KEY_FILE paths.

UNZEEN_CHAIN=hood
UNZEEN_NETWORK=main
UNZEEN_HOOD=on
HOOD_NETWORK=mainnet
UNZEEN_ALLOW_HOOD_MAINNET=yes

DATABASE_URL=__GENERATE__
DATABASE_URL_RELAYER=__GENERATE__

UNZEEN_ALLOW_MAINNET_SEND=1
UNZEEN_ALLOW_MAINNET_ACTIONS=1
UNZEEN_ALLOW_MAINNET_REBALANCE=0

UNZEEN_BIRTHDAY=__SET__
LIGHTWALLETD_URL=https://zec.rocks:443
LIGHTWALLETD_FALLBACK_URLS=https://eu.zec.rocks:443,https://na.zec.rocks:443
LIGHTWALLETD_SEND_URL=https://lwdv3.zecwallet.co:443
UNZEEN_MAX_PAYOUT_ZAT=5000000
UNZEEN_CONFIRMATIONS=3
UNZEEN_PAYOUTS=1
# 1 only after the rebalance address below is set (it exists only after keys:attest / evm:keys).
UNZEEN_REBALANCE=0
RUST_LOG=info,zcash_client_backend=warn,zcash_client_sqlite=warn,schemerz=warn
API_LOG=info

# EVM RPC: paid read RPC + another provider for sends (public RPC answers 429).
HOOD_RPC_URL_MAINNET=__SET__
HOOD_SEND_RPC_URL_MAINNET=__SET__
HOOD_RPC_MAX_RPS=
HOOD_MAX_FEE_WEI=
HOOD_VAULTS=2
HOOD_FUNDERS=1
HOOD_FEE_SWEEP=1

UNZEEN_VENUES=pons
UNZEEN_CREATE_ENABLED=1
UNZEEN_FAIR_LAUNCH=0
ONECLICK_URL=https://1click.chaindefuser.com
ONECLICK_JWT=

# Rebalance ZEC->ETH: address = `evm:keys` rebalance-0. Refund t-address: leave unset.
UNZEEN_REBALANCE_ETH_ADDRESS=
UNZEEN_REBALANCE_LOT_ZAT=6000000
UNZEEN_REBALANCE_KEEP_LAMPORTS=22000000000000000
UNZEEN_REBALANCE_MIN_FREE_LAMPORTS=1000000000000000
UNZEEN_REBALANCE_MAX_PER_DAY=1

UNZEEN_CHAT=1
UNZEEN_SCENARIOS=1
UNZEEN_VERIFY_DAILY=1
UNZEEN_STATS_DAILY=1
# Trading comfort (API v0.28): Pulse "About to graduate" threshold %, ETA pace window (s).
UNZEEN_PULSE_GRADUATING_PCT=70
UNZEEN_PULSE_ETA_WINDOW_SECS=600

API_RL_IP_PER_SEC=1000
API_RL_IP_BURST=3000
API_RL_KEY_PER_MIN=60
API_RL_KEY_BURST=20
