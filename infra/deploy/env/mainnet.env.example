# /etc/unzeen/mainnet.env — instance "mainnet" (Zcash main + Solana mainnet-beta). SECRET: 0640 root:<admin>.
# Source of truth for the values: docs/submission/mainnet-demo-run.md §1.3 and RUNBOOK §4.
# Set by compose: UNZEEN_HOME, API_BIND, API_CORS_ORIGINS, UNZEEN_METADATA_BASE_URL (https, GAP-5),
# *_KEY_FILE paths. DEVNET_ZEC_SOL_RATE must NOT be set (the API refuses to start with it on mainnet).

UNZEEN_NETWORK=main
UNZEEN_SOLANA_CLUSTER=mainnet-beta
SOLANA_CLUSTER=mainnet-beta
UNZEEN_ALLOW_MAINNET=yes

DATABASE_URL=__GENERATE__
DATABASE_URL_RELAYER=__GENERATE__
DATABASE_URL_INDEXER=__GENERATE__

# Guards (lead approval). UNZEEN_ALLOW_MAINNET_REBALANCE only for the run, then 0.
UNZEEN_ALLOW_MAINNET_SEND=1
UNZEEN_ALLOW_MAINNET_ACTIONS=1
UNZEEN_ALLOW_MAINNET_REBALANCE=0

# Zcash. Height just before `unzeen-scanner init` (wallet birthday).
UNZEEN_BIRTHDAY=__SET__
LIGHTWALLETD_URL=https://zec.rocks:443
LIGHTWALLETD_FALLBACK_URLS=https://eu.zec.rocks:443,https://na.zec.rocks:443
# A8: payouts and shield via another operator (RUNBOOK 1.4a).
LIGHTWALLETD_SEND_URL=https://lwdv3.zecwallet.co:443
UNZEEN_MAX_PAYOUT_ZAT=5000000
UNZEEN_CONFIRMATIONS=3
UNZEEN_PAYOUTS=1
# 1 only after the rebalance address below is set (it exists only after keys:attest / evm:keys).
UNZEEN_REBALANCE=0
RUST_LOG=info,zcash_client_backend=warn,zcash_client_sqlite=warn,schemerz=warn
API_LOG=info

# Solana RPC (API keys inside).
SOLANA_RPC_URL_MAINNET=__SET__
SOLANA_READ_RPC_URL_MAINNET=__SET__
SOLANA_INDEX_RPC_URL_MAINNET=__SET__
SHYFT_API_KEY=__SET__
SOLANA_SEND_MIN_INTERVAL_MS=1000

# Venues: +meteora-dbc after `meteora:config --send` (METEORA_DBC_CONFIG_MAINNET), +bags after bags:auth.
UNZEEN_VENUES=pumpfun,jupiter,raydium-launchlab
METEORA_DBC_CONFIG_MAINNET=
BAGS_API_KEY=
JUPITER_API_KEY=
UNZEEN_CREATE_ENABLED=1
UNZEEN_FAIR_LAUNCH=0
# Either PINATA_JWT or the https /media base set by compose (GAP-5).
PINATA_JWT=
ONECLICK_URL=https://1click.chaindefuser.com
ONECLICK_JWT=

# Rebalance ZEC->SOL (mainnet-demo-run §1.3). Refund t-address: leave UNZEEN_REBALANCE_REFUND_TADDR unset.
UNZEEN_REBALANCE_SOL_ADDRESS=
UNZEEN_REBALANCE_LOT_ZAT=3500000
UNZEEN_REBALANCE_MAX_LOT_ZAT=5000000
UNZEEN_REBALANCE_MIN_FREE_LAMPORTS=50000000
UNZEEN_REBALANCE_MAX_PER_DAY=1
UNZEEN_REBALANCE_FUND_DELAY_MIN_SECS=60
UNZEEN_REBALANCE_FUND_DELAY_MAX_SECS=180

FEE_SWEEP_STORE=postgres
RELAYER_FEE_SWEEP=1
RELAYER_STATE=file
MIN_CLAIM_ZAT=1000
UNZEEN_CHAT=1
UNZEEN_SCENARIOS=1
UNZEEN_VERIFY_DAILY=1
UNZEEN_STATS_DAILY=1
# Trading comfort (API v0.28): Pulse "About to graduate" threshold %, ETA pace window (s).
UNZEEN_PULSE_GRADUATING_PCT=70
UNZEEN_PULSE_ETA_WINDOW_SECS=600
# Discovery (fresh launchpad tokens in /tokens and Pulse): API flag + indexer flag. Costs provider
# credits (Helius); INTEL_DISCOVERY_LAUNCHLAB=0 drops LaunchLab creates (mainnet stream only).
UNZEEN_DISCOVERY=0
INTEL_DISCOVERY=0
INTEL_DISCOVERY_LAUNCHLAB=1
# Discovery fast pass (s, 1..60, +-25 % jitter): drain the create streams, admit, read only the new
# ones and commit them, so Pulse gets a token seconds after its create. The metrics pass over all
# candidates stays at 45-75 s. Pump poll at 4 s = ~900 getSignaturesForAddress/h (1 credit each).
INTEL_DISCOVERY_TICK_SECS=4
# GET /api/quote (mainnet only): Jupiter quote grid filled by a background timer, never on a user
# request. UNZEEN_QUOTE=0 turns it off. Round every ROUND_SECS ±20 %, at most RPS upstream requests/s.
UNZEEN_QUOTE=1
UNZEEN_QUOTE_RPS=1
UNZEEN_QUOTE_ROUND_SECS=600
UNZEEN_QUOTE_MAX_MINTS=40
JUPITER_QUOTE_URL=https://api.jup.ag/swap/v1

API_RL_IP_PER_SEC=1000
API_RL_IP_BURST=3000
API_RL_KEY_PER_MIN=60
API_RL_KEY_BURST=20
