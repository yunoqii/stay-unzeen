# /etc/unzeen/devnet.env — instance "devnet" (Zcash testnet + Solana devnet). SECRET: 0640 root:<admin>.
# Values marked __SET__ must be filled; __GENERATE__ lines are written by `unzeenctl keys devnet`.
# Set by compose (do not set here): UNZEEN_HOME, API_BIND, API_CORS_ORIGINS, UNZEEN_METADATA_BASE_URL,
# *_KEY_FILE paths (/run/unzeen-keys/...). Database host is the instance's own `pg-devnet`.

UNZEEN_NETWORK=test
UNZEEN_SOLANA_CLUSTER=devnet
SOLANA_CLUSTER=devnet

DATABASE_URL=__GENERATE__
DATABASE_URL_RELAYER=__GENERATE__
DATABASE_URL_INDEXER=__GENERATE__

# Zcash (public lightwalletd, H1 cover traffic on).
LIGHTWALLETD_URL=https://testnet.zec.rocks:443
LIGHTWALLETD_FALLBACK_URLS=
UNZEEN_CONFIRMATIONS=3
UNZEEN_PAYOUTS=1
UNZEEN_REBALANCE=0
RUST_LOG=info,zcash_client_backend=warn,zcash_client_sqlite=warn,schemerz=warn
API_LOG=info

# Solana RPC (contain API keys): send = Helius, read = Shyft, index = Helius (STACK.md).
SOLANA_RPC_URL_DEVNET=__SET__
SOLANA_READ_RPC_URL_DEVNET=__SET__
SOLANA_INDEX_RPC_URL_DEVNET=__SET__
SHYFT_API_KEY=__SET__
SOLANA_SEND_MIN_INTERVAL_MS=1000
INTEL_READ_RPS=3
INTEL_CURVE_MODE=poll

# Product flags (devnet demo for judges).
UNZEEN_VENUES=pumpfun,meteora-dbc
UNZEEN_CREATE_ENABLED=1
# Until 28.10 23:59 UTC: 0 (no fair-launch routes in the public deploy).
UNZEEN_FAIR_LAUNCH=0
DEVNET_ZEC_SOL_RATE=11.5
FEE_SWEEP_STORE=postgres
RELAYER_FEE_SWEEP=1
RELAYER_STATE=file
UNZEEN_CHAT=1
UNZEEN_SCENARIOS=1
UNZEEN_VERIFY_DAILY=1
UNZEEN_STATS_DAILY=1
# Trading comfort (API v0.28): Pulse "About to graduate" threshold %, ETA pace window (s).
UNZEEN_PULSE_GRADUATING_PCT=70
UNZEEN_PULSE_ETA_WINDOW_SECS=600
# Discovery (fresh launchpad tokens in /tokens and Pulse): API flag + indexer flag. Costs provider
# credits (Helius); INTEL_DISCOVERY_LAUNCHLAB=0 drops LaunchLab creates (mainnet stream only).
UNZEEN_DISCOVERY=0
INTEL_DISCOVERY=0
INTEL_DISCOVERY_LAUNCHLAB=1
ONECLICK_URL=https://1click.chaindefuser.com
ONECLICK_JWT=

# A9: behind Caddy every request comes from one address -> the per-socket limit becomes global.
# Per-client limits are in Caddy; core keeps the per-anon-key limit.
API_RL_IP_PER_SEC=1000
API_RL_IP_BURST=3000
API_RL_KEY_PER_MIN=60
API_RL_KEY_BURST=20
