# Copy to .env (git-ignored). NEVER put seeds/private keys here.

# --- Zcash / core (unzeen-scanner) ---
# Network: test (TAZ, CI/dev) | main (real ZEC: demo only, dust amounts, lead approval)
UNZEEN_NETWORK=test
# Public lightwalletd (gRPC). Empty -> default per network:
#   test: https://testnet.zec.rocks:443   main: https://zec.rocks:443
LIGHTWALLETD_URL=
# Comma-separated fallbacks, tried in order. Empty -> default per network:
#   test: none (no second working public testnet server as of 2026-10-12)
#   main: https://na.zec.rocks:443,https://eu.zec.rocks:443
LIGHTWALLETD_FALLBACK_URLS=
# Final audit A8 (mainnet): broadcast payouts/rebalance through ANOTHER operator than the scan
# servers (zec.rocks), so they cannot pair the pool's payout tx with the wallet fetching it.
# Checked 13.10 (`unzeen-scanner lwd-info --url ...`): https://lwdv3.zecwallet.co:443,
# https://zcash.mysideoftheweb.com:9067. Unset: broadcasts go through the scan servers.
LIGHTWALLETD_SEND_URL=
# Wallet state + keys root, outside the repo/Desktop. Default: ~/.unzeen
# (layout: $UNZEEN_HOME/<network>/{data,keys} for the Solana pool, $UNZEEN_HOME/hood-<network>/{data,keys}
# for the Robinhood Chain pool; dirs 0700, files 0600). data/chain marks the owner instance:
# a wallet of the other chain is refused, and only one `serve` runs per wallet (data/serve.lock).
UNZEEN_HOME=
# Pool instance: solana (default) | hood. Also picks the default wallet dirs above (scanner + API).
UNZEEN_CHAIN=
# Optional explicit overrides of the two dirs above.
UNZEEN_DATA_DIR=
UNZEEN_KEYS_DIR=
# Pool seed is stored age-encrypted (keys/pool.mnemonic.age). Key source, one of:
#   UNZEEN_SEED_KEY_FILE: age identity file (create: unzeen-scanner seed-keygen --out ~/.unzeen/seed.agekey)
#   UNZEEN_SEED_PASSPHRASE: passphrase (visible in the process environment; prefer the key file)
UNZEEN_SEED_KEY_FILE=
UNZEEN_SEED_PASSPHRASE=
# Optional wallet birthday for `init` (default: chain tip - 10)
UNZEEN_BIRTHDAY=
# Mainnet spending is refused unless this is exactly 1 (lead approval required)
UNZEEN_ALLOW_MAINNET_SEND=0
# H1 cover traffic: the scanner fetches EVERY Orchard/Ironwood tx of each scanned block (not
# only ours) in random order. Public servers are shared: keep it polite.
# Measured 12.10: mainnet ~2.2 shielded tx/block, ~25 KiB/block; testnet ~0.2 tx/block.
UNZEEN_COVER_CONCURRENCY=4
UNZEEN_COVER_RPS=20
UNZEEN_COVER_RETRIES=6
# withdraw_zec executor inside `serve` (needs the seed key above). Mainnet also needs
# UNZEEN_ALLOW_MAINNET_SEND=1; single payouts above UNZEEN_MAX_PAYOUT_ZAT wait for review there.
UNZEEN_PAYOUTS=0
UNZEEN_PAYOUT_BATCH=5
UNZEEN_MAX_PAYOUT_ZAT=100000000
# librustzcash logs txids at INFO; `serve` caps it at warn anyway.
RUST_LOG=info,zcash_client_backend=warn,zcash_client_sqlite=warn,schemerz=warn

# --- Ledger policy ---
# Solana cluster bound into memo signatures (chain_id byte 1): devnet | mainnet-beta
UNZEEN_SOLANA_CLUSTER=devnet
# Confirmations before a deposit is credited (K); each note waits K + r, r in 0..JITTER
# (fixed per note), so crediting is not exactly "mined height + K".
UNZEEN_CONFIRMATIONS=3
UNZEEN_CONFIRMATIONS_JITTER=3
# Deposits below this are kept as dust, not credited (zatoshis; 100000 = 0.001 ZEC)
MIN_DEPOSIT_ZAT=100000
# Smallest amount a balance action may reserve (zatoshis)
MIN_ACTION_ZAT=100000
# Smallest creator-fee claim (ZEC equivalent), zat; capped at MIN_ACTION_ZAT (API v0.11 minClaimZat).
MIN_CLAIM_ZAT=10000

# --- Postgres (infra/docker-compose.yml) ---
POSTGRES_USER=unzeen
# Generate: openssl rand -hex 16
POSTGRES_PASSWORD=
# 55432 to avoid clashing with a local Postgres on 5432
POSTGRES_PORT=55432
POSTGRES_DB=unzeen
DATABASE_URL=postgres://unzeen:<password>@127.0.0.1:55432/unzeen
# The TS relayer connects ONLY with the least-privilege role from infra/relayer-role.sql
# (cannot read action_id or any user table). Never give it DATABASE_URL.
DATABASE_URL_RELAYER=postgres://unzeen_relayer:<relayer password>@127.0.0.1:55432/unzeen
# The token indexer (adapters, docs/INTEL.md) connects ONLY with the role from
# infra/indexer-role.sql (intel tables + read-only public market data; no ledger at all).
DATABASE_URL_INDEXER=postgres://unzeen_indexer:<indexer password>@127.0.0.1:55432/unzeen

# --- API server (core/api: `cargo run -p unzeen-api -- serve`) ---
# UNZEEN_NETWORK and UNZEEN_SOLANA_CLUSTER must match: test+devnet (chainId 0202) or
# main+mainnet-beta (0101); the server refuses to start otherwise.
# Behind the reverse proxy on the same host; never 0.0.0.0 in production.
API_BIND=127.0.0.1:8080
# Comma-separated web origins allowed by CORS (each network's API lives at the root of its own origin).
API_CORS_ORIGINS=http://localhost:3000
# Optional: override the pool UA that the scanner publishes in Postgres (pool_meta).
UNZEEN_POOL_ADDRESS=
# Venues accepted for actions (comma-separated): pumpfun, meteora-dbc, jupiter
UNZEEN_VENUES=pumpfun,meteora-dbc
# --- Jupiter (relayer, venue=jupiter; mainnet only: core answers venue_unavailable on devnet) ---
# Optional API key (keyless works with a longer pause between requests).
JUPITER_API_KEY=
# Default https://api.jup.ag/swap/v2
JUPITER_API_URL=
# Pause between Jupiter requests, ms (empty = default for keyed / keyless).
JUPITER_MIN_INTERVAL_MS=
JUPITER_CU_LIMIT=700000
JUPITER_SLIPPAGE_BPS=300
# Meteora DBC config account per network (relayer; devnet config is pump.fun-equivalent, 1% fee)
METEORA_DBC_CONFIG_DEVNET=5MHT8FPocqaLBrz9nHAyCuXSFPRbQxrXvG9E8y1eTZpK
# Mainnet config key: printed by `pnpm meteora:config --send` on mainnet-beta; empty = venue off on mainnet.
METEORA_DBC_CONFIG_MAINNET=
# Mainnet one-time setup scripts (pnpm meteora:config / pnpm launchlab:platform --send). Set ONLY for that run.
UNZEEN_ALLOW_MAINNET_SETUP=
# `create` is refused with 503 until a relayer executes it (lead switches this on).
UNZEEN_CREATE_ENABLED=0
# Token images/metadata published by the relayer, served at GET /media/<sha40>.<ext>.
# Default: $UNZEEN_HOME/<cluster>/media. Relayer: UNZEEN_METADATA_BASE_URL=<this API origin>/media
# Mainnet (GAP-5): UNZEEN_METADATA_BASE_URL must be a PUBLIC https URL, else set PINATA_JWT. A local/http
# URL is refused: the API does not start with UNZEEN_CREATE_ENABLED=1, the relayer fails creates
# with venue_unavailable before signing (the token URI is on chain forever).
UNZEEN_METADATA_BASE_URL=
PINATA_JWT=
UNZEEN_MEDIA_DIR=
# Mainnet-beta: POST /api/actions is refused unless this is exactly 1 (lead approval).
UNZEEN_ALLOW_MAINNET_ACTIONS=0
# Log filter of the API (no IPs/keys/bodies are ever logged; DEBUG adds route+status lines).
API_LOG=info

# ZEC->SOL rate. Devnet: fixed rate, SOL per 1 ZEC (empty -> live NEAR Intents 1Click quote).
# Realistic example (Oct 2026): ~11.5 SOL per ZEC.
DEVNET_ZEC_SOL_RATE=11.5
# NEAR Intents 1Click: dry quotes work without a JWT. Never printed.
ONECLICK_JWT=
ONECLICK_URL=https://1click.chaindefuser.com

# ---- Pool rebalance ZEC -> SOL via 1Click (scanner `serve --rebalance`, RELAYER.md v7) ----
# 1Click has no testnet and takes ZEC only from/to TRANSPARENT addresses. Anywhere but
# UNZEEN_NETWORK=main + UNZEEN_SOLANA_CLUSTER=mainnet-beta + the flag below, the schedule runs
# in DRY-RUN (dry quotes with mainnet parameters are journaled, nothing is sent).
UNZEEN_REBALANCE=0
UNZEEN_ALLOW_MAINNET_REBALANCE=0
# Fixed lot (never derived from user activity), zat; hard cap per lot (absolute ceiling 2 ZEC).
UNZEEN_REBALANCE_LOT_ZAT=50000000
UNZEEN_REBALANCE_MAX_LOT_ZAT=50000000
# Trigger: free SOL (vaults + undistributed - reserve per vault - queued jobs) below this.
UNZEEN_REBALANCE_MIN_FREE_LAMPORTS=2000000000
UNZEEN_REBALANCE_VAULT_RESERVE_LAMPORTS=5000000
UNZEEN_REBALANCE_INVENTORY_MAX_AGE_SECS=900
# Random delay between trigger and execution; cooldown and daily cap.
UNZEEN_REBALANCE_DELAY_MIN_SECS=600
UNZEEN_REBALANCE_DELAY_MAX_SECS=3600
UNZEEN_REBALANCE_COOLDOWN_SECS=3600
UNZEEN_REBALANCE_MAX_PER_DAY=4
UNZEEN_REBALANCE_SLIPPAGE_BPS=100
# Refuse a quote whose minimum is more than this below the 1Click /v0/tokens reference.
UNZEEN_REBALANCE_MAX_DEVIATION_BPS=300
UNZEEN_REBALANCE_QUOTE_DEADLINE_SECS=7200
UNZEEN_REBALANCE_QUOTE_MAX_AGE_SECS=300
UNZEEN_REBALANCE_POLL_SECS=60
# Lamports left on the rebalance address for its own tx fees; rest goes to the vaults.
UNZEEN_REBALANCE_KEEP_LAMPORTS=10000000
UNZEEN_REBALANCE_FUND_DELAY_MIN_SECS=60
UNZEEN_REBALANCE_FUND_DELAY_MAX_SECS=600
UNZEEN_REBALANCE_FEE_MARGIN_ZAT=100000
# The pool's rebalance SOL address (relayer key, NOT a vault, NOT an attestation key).
# Devnet example (public address of the devnet rebalance key): 9adTBnWtpJ9dW656JoygF3DyccryjuYAfygYMjnxYusp
UNZEEN_REBALANCE_SOL_ADDRESS=
# 1Click refund address (t1/t3) for failed swaps. Empty on mainnet = the pool wallet's OWN t-address
# (`unzeen-scanner address --transparent`, never published); recover refunds with `unzeen-scanner shield`.
# Set only to override with another address (then `shield` cannot see the refunds).
UNZEEN_REBALANCE_REFUND_TADDR=

# The quote is refreshed by a timer every 30-60 s, never per action (D14). Older than
# RATE_CACHE_SECS -> spread x2; older than RATE_MAX_STALE_SECS -> actions get 503.
RATE_CACHE_SECS=45
RATE_MAX_STALE_SECS=120
# Pool spread against the user, basis points (50 = 0.5%).
UNZEEN_RATE_SPREAD_BPS=50

# Execution epochs for buy/sell/create (seconds between batch boundaries, uniform random).
# Same default on devnet and mainnet; privacy "max" uses the second pair.
UNZEEN_EPOCH_MIN_SECS=30
UNZEEN_EPOCH_MAX_SECS=60
UNZEEN_MAX_PRIVACY_EPOCH_MIN_SECS=300
UNZEEN_MAX_PRIVACY_EPOCH_MAX_SECS=900
# exec "now" (buy/sell/create): flat fee for the pool's priority lane (one quantized priority
# fee on ALL pool txs; no Jito), zatoshis, part of the hold.
UNZEEN_NOW_FEE_ZAT=5000
WITHDRAW_TOKEN_DELAY_MIN_SECS=30
WITHDRAW_TOKEN_DELAY_MAX_SECS=300
ZEC_PAYOUT_DELAY_MIN_SECS=60
ZEC_PAYOUT_DELAY_MAX_SECS=600

# --- Creator rules of Unzeen launches (API v0.5, enforced by the ledger) ---
# Lock of the creator's initial-buy tokens (seconds; 0 = off). sell/withdraw_token -> 423 creator_locked.
UNZEEN_CREATOR_LOCK_SECS=86400
# Cap of the creator's position through the pool, basis points of the supply (500 = 5%; 0 = off).
# create initial buy / creator buys above it -> 422 creator_cap.
UNZEEN_CREATOR_CAP_BPS=500
# Launch curve FALLBACK for the cap (base units / lamports). The real one comes from the network:
# the relayer writes pump.fun Global into Postgres `launch_curves` (devnet 1 SOL vs mainnet 30 SOL
# virtual reserves). Leave these EMPTY: if UNZEEN_LAUNCH_VIRTUAL_SOL_LAMPORTS is set explicitly,
# fair launch also accepts it when `launch_curves` is empty (otherwise fl_create -> 503).
UNZEEN_LAUNCH_TOTAL_SUPPLY=
UNZEEN_LAUNCH_VIRTUAL_SOL_LAMPORTS=
UNZEEN_LAUNCH_VIRTUAL_TOKEN_RESERVES=
# Creator fee of the launch tx itself goes to the POOL (API v0.9). Exact figure comes from the
# relayer (relayer_jobs.out_creator_fee); until it reports one, core withholds this upper bound,
# bps of the lamports the launch buy paid: pump.fun 30 (top fee tier 0.30%), Meteora DBC 40
# (1% fee x 80% after Meteora x 50% creator).
UNZEEN_LAUNCH_CREATOR_FEE_BPS_PUMPFUN=30
UNZEEN_LAUNCH_CREATOR_FEE_BPS_DBC=40

# --- Creator-fee sweeper (relayer, RELAYER.md v4) ---
# 1 = run the global sweeper inside relayer:run (random 6-12 h schedule, never on user request).
RELAYER_FEE_SWEEP=0
# postgres = record sweeps in creator_fee_sweeps (core credits creators from it); empty = keys-dir JSON file.
FEE_SWEEP_STORE=postgres
# Minimum claimable lamports per target worth a tx (also >= 5x the tx cost).
FEE_SWEEP_MIN_LAMPORTS=2000000

# --- Verify (API.md v0.7) ---
# Daily snapshot at 00:00 UTC. Empty -> on for mainnet-beta, off for devnet (devnet: run
# `cargo run -p unzeen-api -- verify-snapshot` while the API server is running).
UNZEEN_VERIFY_DAILY=

# --- Public stats GET /api/stats (API.md v0.9, H6: daily, rounded, k-anonymous) ---
# Snapshot at 00:00 UTC. Empty -> on for mainnet-beta, off for devnet (devnet: run
# `cargo run -p unzeen-api -- stats-snapshot`; data cut-off is 00:00 UTC of today).
UNZEEN_STATS_DAILY=
# SOL volumes rounded down to this (lamports; 100000000 = 0.1 SOL).
UNZEEN_STATS_SOL_ROUND_LAMPORTS=100000000
# Shielded ZEC total rounded down to this (zat; 100000000 = 1 ZEC; never below 0.01 ZEC).
UNZEEN_STATS_ZEC_ROUND_ZAT=100000000

# --- Fair launch (API.md v0.6). INTERNAL until 28.10 23:59 UTC: keep 0 on any public deploy ---
# 1 = enabled. 0 (default): /api/launches* -> 404, fl_* -> 400 like an unknown op, no PoolInfo block.
UNZEEN_FAIR_LAUNCH=0
# Allowed bid windows, seconds (120 = demo only).
UNZEEN_FL_WINDOWS_SECS=120,300,600,1800
# Hold tiers in zatoshis, ascending. Empty -> default per network:
#   mainnet 0.05/0.1/0.25/0.5/1/2.5/5/10 ZEC; devnet 0.001/0.0025/0.005/0.01/0.025/0.05 TAZ
UNZEEN_FL_HOLD_TIERS_ZAT=
# Cap of the total launch buy, basis points of supply (2500 = 25%, far from graduation).
UNZEEN_FL_MAX_TOTAL_BPS=2500
# Public bid count only from this many valid bids, else "<N".
UNZEEN_FL_MIN_BIDS_FOR_COUNT=5
# Venue fee bound for min_out of the launch buy (bps; +50 bps slippage).
UNZEEN_FL_FEE_BOUND_BPS=300
# drand quicknet relays (server only; the browser never talks to drand). Empty -> 4 public relays.
UNZEEN_DRAND_URLS=

# --- Token intel (docs/INTEL.md) ---
# Full per-mint trade feed (needs a streaming RPC plan): enables /trades?filter=whales|dev.
UNZEEN_INTEL_FULL_TRADES=0
# Max pending CA requests waiting for the indexer tick.
UNZEEN_INTEL_QUEUE_MAX=256
# `whale` tag threshold (lamports).
UNZEEN_WHALE_LAMPORTS=1000000000

# Fees (zatoshis / lamports)
CREATE_FEE_ZAT=100000
WITHDRAW_ZEC_FEE_ZAT=15000
WITHDRAW_TOKEN_GAS_LAMPORTS=2000000
WITHDRAW_TOKEN_COST_LAMPORTS=2100000

# In-memory rate limits (per socket peer; per anon key)
API_RL_IP_PER_SEC=20
API_RL_IP_BURST=60
API_RL_KEY_PER_MIN=60
API_RL_KEY_BURST=20
API_MAX_WS=2000

# ---- /tokens Discovery and token chat (API.md v0.12) ----
# Discovery list GET /api/tokens?source=discovery (needs the indexer's INTEL_DISCOVERY=1). Off by default.
UNZEEN_DISCOVERY=0
# Anonymous token chat. Needs K_chat: `unzeen-api chat-keygen --out /etc/unzeen/<net>-chat.key`
# (keep it OUTSIDE the repo, the DB and backups; one per network; rotating renames every nick).
UNZEEN_CHAT=0
UNZEEN_CHAT_KEY_FILE=
# Admission: ZEC + tokens at the tick price, zat (default 5000000 mainnet, 100000 devnet).
UNZEEN_CHAT_MIN_ACCOUNT_ZAT=
# Cover traffic: accept op "noop" (R8), PoolInfo.features.noop.
UNZEEN_NOOP=0

# --- Robinhood Chain (EVM, venue "pons"), feature flag `hood` -------------------
# Off unless UNZEEN_HOOD=on. HOOD_NETWORK=testnet|mainnet (default testnet; Pons
# exists on mainnet only). Mainnet is READ-ONLY (eth_call / simulations) unless
# UNZEEN_ALLOW_HOOD_MAINNET=yes (lead's explicit approval).
UNZEEN_HOOD=
HOOD_NETWORK=
UNZEEN_ALLOW_HOOD_MAINNET=
# Read RPC per network (keyed provider recommended: the public mainnet RPC
# answers a Cloudflare challenge after ~10 fast requests). Empty = public RPC.
HOOD_RPC_URL_MAINNET=
HOOD_RPC_URL_TESTNET=
# Optional send RPC at a different provider (default = read RPC).
HOOD_SEND_RPC_URL_MAINNET=
HOOD_SEND_RPC_URL_TESTNET=
# Requests/second per RPC (default 4 on public endpoints, 20 with a key).
HOOD_RPC_MAX_RPS=
# Pool-wide constant maxFeePerGas floor, wei (default 200000000 = 0.2 gwei).
HOOD_MAX_FEE_WEI=
# EVM seed dir (default $UNZEEN_HOME/hood-<network>/evm) and its age identity
# (outside the dir; falls back to SOLANA_KEYS_AGE_KEY_FILE). Required on mainnet.
HOOD_KEYS_DIR=
HOOD_KEYS_AGE_KEY_FILE=
# Hood funder thresholds, wei (defaults: target 0.02 ETH, low 0.011 ETH, lot 0.005 ETH); low < target, lot <= target
HOOD_FUNDER_TARGET_WEI=
HOOD_FUNDER_LOW_WEI=
HOOD_FUNDER_LOT_WEI=
# Hood: poll of the rebalance address for new ETH -> funder top-up, seconds (30..3600, default 300)
HOOD_FUNDER_POLL_SECS=
# Tests only: anvil fork source for `pnpm test:fork` (default HOOD_RPC_URL_MAINNET, then public dRPC).
HOOD_FORK_URL=
