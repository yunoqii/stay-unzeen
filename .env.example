# Copy to .env (git-ignored). NEVER put seeds/private keys here.

# --- Zcash / core (unzeen-scanner) ---
# Network: test (TAZ, CI/dev) | main (real ZEC: demo only, dust amounts, lead approval)
UNZEEN_NETWORK=test
# Public lightwalletd (gRPC). Empty -> default per network:
#   test: https://testnet.zec.rocks:443   main: https://zec.rocks:443
LIGHTWALLETD_URL=
# Comma-separated fallbacks, tried in order. Empty -> default per network:
#   test: none (no second working public testnet server as of 2026-10-12)
#   main: https://na.zec.rocks:443,https://eu.zec.rocks:443
LIGHTWALLETD_FALLBACK_URLS=
# Wallet state + keys root, outside the repo/Desktop. Default: ~/.unzeen
# (layout: $UNZEEN_HOME/<network>/{data,keys}, dirs 0700, files 0600).
UNZEEN_HOME=
# Optional explicit overrides of the two dirs above.
UNZEEN_DATA_DIR=
UNZEEN_KEYS_DIR=
# Pool seed is stored age-encrypted (keys/pool.mnemonic.age). Key source, one of:
#   UNZEEN_SEED_KEY_FILE: age identity file (create: unzeen-scanner seed-keygen --out ~/.unzeen/seed.agekey)
#   UNZEEN_SEED_PASSPHRASE: passphrase (visible in the process environment; prefer the key file)
UNZEEN_SEED_KEY_FILE=
UNZEEN_SEED_PASSPHRASE=
# Optional wallet birthday for `init` (default: chain tip - 10)
UNZEEN_BIRTHDAY=
# Mainnet spending is refused unless this is exactly 1 (lead approval required)
UNZEEN_ALLOW_MAINNET_SEND=0
# librustzcash logs txids at INFO; `serve` caps it at warn anyway.
RUST_LOG=info,zcash_client_backend=warn,zcash_client_sqlite=warn,schemerz=warn

# --- Ledger policy ---
# Solana cluster bound into memo signatures (chain_id byte 1): devnet | mainnet-beta
UNZEEN_SOLANA_CLUSTER=devnet
# Confirmations before a deposit is credited (K)
UNZEEN_CONFIRMATIONS=3
# Deposits below this are kept as dust, not credited (zatoshis; 100000 = 0.001 ZEC)
MIN_DEPOSIT_ZAT=100000
# Smallest amount a balance action may reserve (zatoshis)
MIN_ACTION_ZAT=100000

# --- Postgres (infra/docker-compose.yml) ---
POSTGRES_USER=unzeen
# Generate: openssl rand -hex 16
POSTGRES_PASSWORD=
# 55432 to avoid clashing with a local Postgres on 5432
POSTGRES_PORT=55432
POSTGRES_DB=unzeen
DATABASE_URL=postgres://unzeen:<password>@127.0.0.1:55432/unzeen
