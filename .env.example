# Copy to .env (git-ignored). NEVER put seeds/private keys here; the pool seed lives in keys/.

# --- Zcash / core (unzeen-scanner) ---
# Network: test (TAZ, CI/dev) | main (real ZEC: demo only, dust amounts, lead approval)
UNZEEN_NETWORK=test
# lightwalletd gRPC. Empty -> default per network:
#   test: https://testnet.zec.rocks:443   main: https://zec.rocks:443
#   self-hosted (infra/docker-compose.yml --profile node): http://127.0.0.1:9067
LIGHTWALLETD_URL=
# Wallet state (sqlite) and secret material. Both are git-ignored. Paths are relative to CWD.
UNZEEN_DATA_DIR=./data
UNZEEN_KEYS_DIR=./keys
# Optional wallet birthday for `init` (default: chain tip - 10)
UNZEEN_BIRTHDAY=
# Mainnet spending is refused unless this is exactly 1 (lead approval required)
UNZEEN_ALLOW_MAINNET_SEND=0
RUST_LOG=info,schemerz=warn

# --- Postgres (infra/docker-compose.yml) ---
POSTGRES_USER=unzeen
POSTGRES_PASSWORD=change-me
POSTGRES_DB=unzeen
POSTGRES_PORT=5432
DATABASE_URL=postgres://unzeen:change-me@127.0.0.1:5432/unzeen

# --- Self-hosted node (docker compose --profile node) ---
ZEBRA_VERSION=7.0.0-rc.0
LWD_VERSION=v0.5.5
# Testnet: ZEBRA_NETWORK=Testnet, ZEBRA_RPC_PORT=18232, ZEBRA_P2P_PORT=18233
# Mainnet: ZEBRA_NETWORK=Mainnet, ZEBRA_RPC_PORT=8232,  ZEBRA_P2P_PORT=8233
ZEBRA_NETWORK=Testnet
ZEBRA_RPC_PORT=18232
ZEBRA_P2P_PORT=18233
