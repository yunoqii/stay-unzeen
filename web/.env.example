# mock (default) | real
NEXT_PUBLIC_API_MODE=mock
# REST base of core/ per network (empty = same origin). Devnet falls back to NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_API_URL_DEVNET=
NEXT_PUBLIC_API_URL_MAINNET=
# WebSocket base per network (empty = derived from the REST base)
NEXT_PUBLIC_WS_URL_DEVNET=
NEXT_PUBLIC_WS_URL_MAINNET=
# Mock only: sealed-bid launch (API v0.6) in the in-browser mock. Unset = server without the feature.
NEXT_PUBLIC_MOCK_FAIR_LAUNCH=
# Mock only: =1 shows the "Launching is temporarily disabled" state (createEnabled=false).
NEXT_PUBLIC_MOCK_CREATE_DISABLED=
# =1 compiles the sealed-bid launch in (lazy chunk, loaded only when /api/pool reports it on).
# Default (empty): not in the build at all. Public deploys: `pnpm build:public` (fails if it leaks).
NEXT_PUBLIC_FAIR_LAUNCH_BUILD=
# Pool attestation key per network (base58), pinned in the build: /verify checks every snapshot's
# operator.pubkey against it. Empty in mock mode = the mock operator key; empty in real mode = "not pinned".
NEXT_PUBLIC_ATTESTATION_PUBKEY_DEVNET=
NEXT_PUBLIC_ATTESTATION_PUBKEY_MAINNET=
