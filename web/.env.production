# Read by every `next build` (production), including the web Docker image, after the process env.
# 0 = Mainnet-only site: Devnet is not listed, not selectable, and the Devnet/Mainnet switch is hidden.
# Set to 1 (or delete the line) to bring Devnet back; a NEXT_PUBLIC_DEVNET build arg overrides this file.
NEXT_PUBLIC_DEVNET=0
