# Adapters / relayer settings. Normally they live in the repo-root .env (git-ignored),
# which the scripts load automatically; this file only documents the variables.
# NEVER put private keys or seeds here.

# Solana cluster. Falls back to UNZEEN_SOLANA_CLUSTER, then devnet.
# mainnet-beta is refused unless UNZEEN_ALLOW_MAINNET=yes (lead approval required).
SOLANA_CLUSTER=devnet
# RPC per cluster (Helius etc.; URLs contain an api key: never print them).
SOLANA_RPC_URL_DEVNET=
SOLANA_RPC_URL_MAINNET=
# Generic fallback when the per-cluster one is empty; then the public endpoint.
# Relayer side = Helius (decision 12.10): sends, confirmations, blockhash, relayer reads. Never used by intel on mainnet.
SOLANA_RPC_URL=

# --- Read side (token intel, pnpm intel:run): Shyft Free. Never falls back to the Helius URLs above.
SHYFT_API_KEY=
SOLANA_READ_RPC_URL_MAINNET=https://rpc.shyft.to?api_key=<SHYFT_API_KEY>
SOLANA_READ_RPC_URL_DEVNET=https://devnet-rpc.shyft.to?api_key=<SHYFT_API_KEY>
# WS for accountSubscribe; default https->wss of the read URL. Shyft Free refused the WS handshake from
# our host on 12.10 (devnet 503, mainnet 429), so INTEL_CURVE_MODE defaults to poll.
SOLANA_READ_WS_URL_MAINNET=
SOLANA_READ_WS_URL_DEVNET=
# getTokenLargestAccounts (top-10, dev share) is an "index" call: Shyft Free answers 403
# IndexNotAllowedOnFreePlan. Provider to be chosen by the lead. Devnet falls back to SOLANA_RPC_URL_DEVNET;
# mainnet has NO fallback (holders are skipped) so the send provider never sees our reads.
SOLANA_INDEX_RPC_URL_MAINNET=
SOLANA_INDEX_RPC_URL_DEVNET=
# Read rate limit, requests/s (docs/INTEL.md: ~5; Shyft Free allows 10).
INTEL_READ_RPS=5
# Curve updates of the warm set: poll (default, one getMultipleAccounts every 15 s ± 3 s) | ws | off.
INTEL_CURVE_MODE=poll
# Expensive tier (first blocks: snipers / same-slot buyers; dev history). Designed, OFF by default.
INTEL_FULL=0
# Discovery mode of /tokens (FEATURES 9): ALL fresh pump.fun / Meteora DBC tokens. OFF by default (credits);
# 1 = on (video, tests). Public stream only: nothing is read on user request, metrics only on its own tick.
INTEL_DISCOVERY=0
# Provider (Helius). Default: SOLANA_RPC_URL_<NET>. Discovery reads never depend on users.
INTEL_DISCOVERY_RPC_URL_MAINNET=
INTEL_DISCOVERY_RPC_URL_DEVNET=
# At most MAX candidates in the last WINDOW_H hours, admitted smoothly (bucket of BURST), newest first.
INTEL_DISCOVERY_MAX=200
INTEL_DISCOVERY_WINDOW_H=6
INTEL_DISCOVERY_BURST=10
# pump.fun creates: poll (default: getSignaturesForAddress of the create-only mint-authority PDA, 1/tick)
# | ws (logsSubscribe on that PDA, ~13 MB/h of WS data) | off.
INTEL_DISCOVERY_PUMP=poll
# Meteora DBC creates: Helius Parsed Streams (1 credit per create). Mainnet default:
# wss://beta.helius-rpc.com/?api-key=<key of the RPC URL>. 0 = off. Devnet: off unless a URL is set.
INTEL_DISCOVERY_DBC=
INTEL_DISCOVERY_DBC_STREAM_URL=
# Budget guard: max DBC events per hour; above it the stream is closed until the hour ends.
INTEL_DISCOVERY_DBC_MAX_PER_H=600
# Request rate of discovery reads (req/s).
INTEL_DISCOVERY_RPS=2
# The one IPFS gateway ipfs:// uris are rewritten to (server-side fetch only).
INTEL_IPFS_GATEWAY=https://ipfs.io/ipfs
# Indexer DB role unzeen_indexer (infra/indexer-role.sql). Never DATABASE_URL / DATABASE_URL_RELAYER.
DATABASE_URL_INDEXER=
# Re-encoded third-party token images (default UNZEEN_METADATA_DIR, then $UNZEEN_HOME/<cluster>/media);
# URLs are ${UNZEEN_METADATA_BASE_URL}/<sha40>.<ext>, base must end with /media.
UNZEEN_MEDIA_DIR=
# Relayer writes creator-pubkeys.json (public creator addresses) into SOLANA_KEYS_DIR; the indexer reads
# it for T1. Backfill for past launches: pnpm keys:creators-pub

# --- Send side (relayer)
# getPriorityFeeEstimate URL, independent of the main RPC (rpc-providers P5). Default: SOLANA_RPC_URL_MAINNET.
SOLANA_PRIORITY_FEE_URL=
# Mainnet sends go through Helius Sender (SWQOS-only). Default:
# https://sender.helius-rpc.com/fast?swqos_only=true + api-key of SOLANA_RPC_URL_MAINNET. Devnet: plain sendTransaction.
SOLANA_SENDER_URL=
# Pool-wide Sender tip, lamports, on EVERY mainnet pool tx (buy/sell/create/withdraw/lookup tables). Min 5000.
SOLANA_SENDER_TIP_LAMPORTS=5000
# Min ms between sends (Helius Free sendTransaction / keyless Sender: 1 tx/s). Rebroadcasts are dropped when busy.
SOLANA_SEND_MIN_INTERVAL_MS=1000
# Vault / creator keys. Default: $UNZEEN_HOME/<cluster>/solana (~/.unzeen/devnet/solana),
# dir 0700, files 0600, outside the repo. Not UNZEEN_KEYS_DIR (that is core's Zcash dir).
SOLANA_KEYS_DIR=
# Priority fee (R-relayer-2): ONE quantized compute unit price for every pool tx (any op, any mode),
# from a background cache refreshed every 10-20 s; never estimated per transaction.
# Source: helius (getPriorityFeeEstimate on SOLANA_PRIORITY_FEE_URL, accountKeys = venue programs only; default on mainnet)
#       | rpc (getRecentPrioritizationFees; default on devnet, Helius devnet has no estimate) | fixed.
SOLANA_PRIORITY_FEE_SOURCE=
# Raw seed / fixed value, micro-lamports per CU (quantized to 1k,2k,5k,...,1M; 0 = lowest level).
SOLANA_PRIORITY_MICROLAMPORTS=0
# Clamp, micro-lamports per CU (default 1000000).
SOLANA_PRIORITY_MAX_MICROLAMPORTS=
# age identity for the Solana keys (vault-*.json.age, creator-master.hex.age).
# Must be OUTSIDE the keys dir; production: /etc/unzeen/solana.agekey (root:unzeen 0640) or a
# systemd credential, not on the data volume. Create + migrate: pnpm keys:encrypt. Required on mainnet.
SOLANA_KEYS_AGE_KEY_FILE=
# Relayer DB role (D8): unzeen_relayer from infra/relayer-role.sql, NOT the owner DATABASE_URL.
# Required on mainnet; devnet falls back to DATABASE_URL with a warning.
DATABASE_URL_RELAYER=
# Token metadata (create): public base URL that serves UNZEEN_METADATA_DIR
# (default $UNZEEN_HOME/<cluster>/media). MUST be the API origin + /media (the API serves
# /media/* and the web app shows images only from the API origin, CSP img-src):
#   devnet: http://127.0.0.1:8080/media   (mainnet API: its own origin + /media)
# NOT pnpm media:serve on 8787: the frontend renders those images as a glyph (RUNBOOK 1.9).
UNZEEN_METADATA_BASE_URL=
UNZEEN_METADATA_DIR=
# Alternative: IPFS via Pinata (takes precedence when set).
PINATA_JWT=
PINATA_GATEWAY_URL=
# Mint -> vault pins (D4): core's mint_vaults table (default) | file (DB without migration 0003).
RELAYER_MINT_VAULTS=
# Rotation + creator counter: file (default) | postgres (after core adds relayer_vault_usage,
# relayer_creator_counter).
RELAYER_STATE=file

# --- Fair-launch v2: multi-vault Jito bundles (MAINNET ONLY; devnet has no Jito -> one tx).
# Jito is used ONLY for fair-launch bundles (decision 13.10), never for Now / other pool txs.
# Off switch (mainnet): 0 = every fair launch is one tx, capped to one vault.
FAIR_JITO=
# Block engine (default https://mainnet.block-engine.jito.wtf; a regional URL is fine).
JITO_BLOCK_ENGINE_URL=
# Optional Jito UUID (x-jito-auth header; keyless = 1 req/s/IP/region). Never logged. SECRET-ish: .env only.
JITO_UUID=
# Tip per bundle leg = this percentile of tip_floor (background refresh 30-60 s), quantized up to
# 1k,2k,5k,10k,... lamports and clamped by JITO_MAX_TIP_LAMPORTS (default 100000 = 0.0001 SOL).
JITO_TIP_PERCENTILE=75
JITO_MAX_TIP_LAMPORTS=100000
# Max legs per bundle (2..5, Jito max 5) and bundle sends per launch before the capped single tx (1..5).
FAIR_BUNDLE_MAX_LEGS=5
FAIR_BUNDLE_TRIES=2
# Optional cap per vault (lamports): above it the launch is split even if one vault could carry it.
FAIR_MAX_PER_VAULT_LAMPORTS=

# --- Non-SOL pairs (lead 13.10, RELAYER v8): ledger in lamports, quote STOCK per vault, in-tx swap leg only as fallback.
# Pool A (pinned SOL/quote pool) and quote mints per network; defaults in src/pool-a.ts:
#   mainnet USDC -> Meteora DAMM v2 8Pm2kZ…; mainnet USD1 -> Raydium CLMM AQAGYQ… (no liquid DAMM v2 pool);
#   devnet USDC (Raydium's USDCoct…) -> DAMM v2 H9TBVi….
# Meteora DBC / LaunchLab quote set:
#   QUOTE_<SYM>_MINT_<NET>= POOL_A_<SYM>_<NET>= METEORA_DBC_CONFIG_<NET>_<SYM>=   (SYM = USDC | USD1, NET = DEVNET | MAINNET;
#   POOL_A_*=none disables the pair; an overriding pool A must be of the same program as the default one)
# pump.fun quote set (devnet USDC = pump's 4zMMC9…): PUMP_QUOTE_USDC_MINT_<NET>= PUMP_POOL_A_USDC_<NET>=
# ZEC (SPL A7bd…QXaS, mainnet): stock-only quote (no pool A, no leg; amounts in ZEC units, core values them).
# Served on pump.fun AND LaunchLab only when 1 (owner decision pending).
PUMP_QUOTE_ZEC=0
# Quote stock policy per symbol, whole tokens (default target mainnet 50 / devnet 2; low = target/2, high = target*3).
# QUOTE_STOCK_<SYM>_LOW= / _HIGH= override the bounds. ZEC stock is moved from the rebalance address (fund_quote).
QUOTE_STOCK_USDC_TARGET=
QUOTE_STOCK_USD1_TARGET=
QUOTE_STOCK_ZEC_TARGET=
# Relayer-local stock schedule (random 45-90 min rounds). RELAYER v8: core schedules `fund_quote` -> keep 0.
RELAYER_QUOTE_STOCK=0

# --- Raydium LaunchLab (venue raydium-launchlab; core meta.platform = unzeen | stonk | bonk).
# No variables: stonk.fun / bonk.fun platform ids and the GlobalConfig per quote are pinned in src/launchlab.ts
# (mainnet only; devnet has only "unzeen"). Unzeen's platform = PDA of the partner key (derived from the creator
# master seed); create it once per network: pnpm launchlab:platform (devnet --send; mainnet prints the message only).
# Checks: pnpm launchlab:devnet (devnet e2e), pnpm launchlab:probe [--quote USD1 [--leg]] (mainnet, simulate only),
# pnpm launchlab:leg-local dump <dir> | run (mainnet state in a local solana-test-validator, nothing sent to mainnet).

# --- Creator-fee sweep (pnpm fees:sweep, or RELAYER_FEE_SWEEP=1 inside the relayer)
RELAYER_FEE_SWEEP=0
# file (devnet default, fee-sweeps.json in the keys dir) | postgres (creator_fee_sweeps, core 0010/0019/0020).
FEE_SWEEP_STORE=file
# Never collect less than this (lamports); also >= 5 x (tx cost + rent the tx locks for good).
FEE_SWEEP_MIN_LAMPORTS=2000000
# Fees in quote tokens (RELAYER v9 §2): USDC / USD1 are valued on pool A (lamports = that value);
# ZEC SPL has no SOL price here: minimum per collection in whole tokens (default 0.05).
FEE_SWEEP_MIN_ZEC=
# Venues: pump.fun (SOL + quote curves), Meteora DBC (every Unzeen config, fees in its quote),
# Raydium LaunchLab (creator fee vaults of our launches + the Unzeen platform's fee vaults, partner key).
