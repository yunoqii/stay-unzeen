# Solana cluster for the adapters. devnet by default; mainnet-beta is refused
# unless UNZEEN_ALLOW_MAINNET=yes (lead approval required).
SOLANA_CLUSTER=devnet
# Optional custom RPC (Helius etc). Defaults to the public endpoint of the cluster.
SOLANA_RPC_URL=
# Where vault / creator keys live (gitignored). Relative to adapters/.
UNZEEN_KEYS_DIR=keys
# Priority fee in micro-lamports per CU (0 on devnet).
SOLANA_PRIORITY_MICROLAMPORTS=0
